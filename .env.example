# ---------------------------------------------------------------------------
# Client-side config. Everything with a VITE_ prefix is baked into the public
# bundle, so ONLY the anon key belongs here. The anon key is safe to expose —
# it is gated by Row Level Security. Never put a service_role key in this file.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
VITE_SUPABASE_BUCKET=uploads

# Optional: put this app's tables in their own Postgres schema so several
# apps can share one free-tier project. Leave unset for `public`.
# VITE_SUPABASE_SCHEMA=shipflow

# Secrets (Gemini, Mailgun) are NOT here. They live in Supabase Edge Function
# secrets:  supabase secrets set GEMINI_API_KEY=... MAILGUN_API_KEY=...
